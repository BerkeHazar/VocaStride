{
  "name": "vocastride",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "description": "VocaStride — aralıklı tekrar ile İngilizce kelime öğrenme uygulaması. Çevrimdışı PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "icons": "node scripts/icons.mjs",
    "og": "node scripts/og.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "bands": "node scripts/build-bands.mjs",
    "audit": "node scripts/audit-levels.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Berke Hazar",
  "license": "MIT",
  "homepage": "https://berkehazar.github.io/VocaStride/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerkeHazar/VocaStride.git"
  },
  "bugs": {
    "url": "https://github.com/BerkeHazar/VocaStride/issues"
  },
  "keywords": [
    "vocabulary",
    "spaced-repetition",
    "leitner",
    "pwa",
    "react",
    "typescript",
    "education",
    "turkish"
  ]
}